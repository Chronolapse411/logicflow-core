<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>OmniService</RootNamespace>
    <AssemblyName>OmniService</AssemblyName>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>LogicFlow Background Agent — Windows service for automated health monitoring</Description>
    <Company>DelgadoLogic.Tech</Company>
    <Product>OmniService</Product>
    <Version>1.0.0</Version>
    <Copyright>© 2026 DelgadoLogic.Tech. All rights reserved.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OmniCore.Engine\OmniCore.Engine.csproj" />
    <ProjectReference Include="..\LogicFlow.Sentinel\LogicFlow.Sentinel.csproj" />
    <ProjectReference Include="..\LogicFlow.Guardian\LogicFlow.Guardian.csproj" />
    <ProjectReference Include="..\LogicFlow.Registry\LogicFlow.Registry.csproj" />
    <ProjectReference Include="..\LogicFlow.Native\LogicFlow.Native.csproj" />
  </ItemGroup>
</Project>
