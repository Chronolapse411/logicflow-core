                                </Border>
                                <ItemsControl x:Name="JunkList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Memory Optimizer -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🧠 MEMORY OPTIMIZER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="💿 Virtual Memory" Style="{StaticResource ActionButton}" Click="OnVirtualMemoryOptimize" Background="#00897B" Margin="0,0,8,0"/>
                                        <Button Content="🧠 Optimize RAM" Style="{StaticResource ActionButton}" Click="OnMemoryOptimize" Background="#7C4DFF"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="MemOptStatus" Text="Free up RAM without killing processes..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border x:Name="MemOptSummaryBar" Background="#1A1F2E" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="MemOptSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}"/>
                                </Border>
                                <ItemsControl x:Name="MemOptList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Turbo Mode Overhaul -->
                        <Border x:Name="TurboModeContainer" Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <!-- We will animate border color programmatically when mode activates -->
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🚀 TURBO MODE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnTurboGaming" Content="🎮 GAMING" Style="{StaticResource OutlineButton}" Click="OnTurboGaming" Margin="0,0,8,0" Foreground="{StaticResource TurboGamingOrangeBrush}"  BorderBrush="{StaticResource TurboGamingOrangeBrush}" />
                                        <Button x:Name="BtnTurboWork" Content="💼 WORK" Style="{StaticResource OutlineButton}" Click="OnTurboWork" Margin="0,0,8,0" Foreground="{StaticResource TurboWorkPurpleBrush}" BorderBrush="{StaticResource TurboWorkPurpleBrush}"/>
                                        <Button x:Name="BtnTurboBattery" Content="🔋 BATTERY" Style="{StaticResource OutlineButton}" Click="OnTurboBattery" Margin="0,0,8,0" Foreground="{StaticResource TurboBatteryGreenBrush}" BorderBrush="{StaticResource TurboBatteryGreenBrush}"/>
                                        <Button x:Name="BtnTurboServer" Content="🖥 SERVER" Style="{StaticResource OutlineButton}" Click="OnTurboServer" Margin="0,0,8,0" Foreground="{StaticResource BrandCyanBrush}" BorderBrush="{StaticResource BrandCyanBrush}"/>
                                        <Button x:Name="BtnTurboOff" Content="⏹ REVERT TO NORMAL" Style="{StaticResource ActionButton}" Click="OnTurboDeactivate"
                                                Visibility="Collapsed" Background="{StaticResource DangerRedBrush}" Foreground="White" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                                
                                <TextBlock x:Name="TurboModeStatus" Text="Forcefully suspend non-essential processes, configure CPU affinity, and alter network routing for raw power." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                
                                <!-- Active Data Reporting Panel -->
                                <Border x:Name="TurboSummaryBar" Background="#0A0E14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,12" Margin="0,16,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="TurboSummaryText" Text="SYSTEM OVERRIDDEN" FontSize="14" FontWeight="ExtraBold" Foreground="{StaticResource TurboGamingOrangeBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <ItemsControl x:Name="TurboActionList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Disk Space Analyzer -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📊 DISK SPACE ANALYZER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="📊 Analyze C:" Style="{StaticResource ActionButton}" Click="OnDiskSpaceAnalyze" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="DiskSpaceStatus" Text="Visual breakdown of disk usage by folder and file type" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border x:Name="DiskSpaceSummaryBar" Background="#1A1F2E" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="DiskSpaceSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                                <ItemsControl x:Name="DiskSpaceList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Duplicate File Finder -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍 DUPLICATE FILE FINDER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🔍 Find Duplicates" Style="{StaticResource ActionButton}" Click="OnDuplicateScan" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="DuplicateStatus" Text="Scan for duplicate files wasting disk space (SHA-256 hash)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border x:Name="DuplicateSummaryBar" Background="#1A1F2E" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="DuplicateSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                                <ItemsControl x:Name="DuplicateList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- File Shredder -->
                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🗑 FILE SHREDDER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🗑 Select Files to Shred" Style="{StaticResource ActionButton}" Click="OnFileShredder" Background="#D32F2F" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="ShredderStatus" Text="DoD 5220.22-M compliant secure file deletion — unrecoverable" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border x:Name="ShredderSummaryBar" Background="#1A1F2E" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="ShredderSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ──── Settings Page ──── -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Padding="24" Visibility="Collapsed">
                    <StackPanel x:Name="SettingsContent" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="0" Y="0"/>
                        </StackPanel.RenderTransform>
                        <!-- 1. System Behavior Card -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="SYSTEM BEHAVIOR" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <CheckBox x:Name="SettingStartWithWindows" Content="Start LogicFlow with Windows" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                <CheckBox x:Name="SettingMinimizeToTray" Content="Minimize to system tray on close" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                <CheckBox x:Name="SettingShowNotifications" Content="Show system tray notifications" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                <CheckBox x:Name="SettingCheckForUpdates" Content="Check for updates automatically" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. Scan Preferences Card -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="SCAN PREFERENCES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <CheckBox x:Name="SettingAutoScanOnStartup" Content="Perform automatic scan on application launch" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                <CheckBox x:Name="SettingScanDriversOnStartup" Content="Include driver health checks during startup scans" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                <CheckBox x:Name="SettingScanRegistryOnStartup" Content="Include deep registry scan during startup scans" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                <CheckBox x:Name="SettingScanSmartOnStartup" Content="Check drive SMART diagnostics automatically on load" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. Security & Privacy Card -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="SECURITY &amp; PRIVACY" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="SettingLocalAiOnly" Content="Zero-Cloud Local AI Diagnostic Engine" Style="{StaticResource ToggleSwitchStyle}" IsEnabled="False" IsChecked="True" Margin="0" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#1500E5FF" BorderThickness="1" BorderBrush="{StaticResource BrandCyanBrush}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="🔒 High Security Mode Locked" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrandCyanBrush}"/>
                                    </Border>
                                </Grid>
                                <CheckBox x:Name="SettingTelemetryBlocking" Content="Block Windows diagnostic telemetry and data tracking" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                <CheckBox x:Name="SettingAutoScrubPrivacy" Content="Enable automatic background privacy scrubbing" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                <CheckBox x:Name="SettingAllowUnsafeRegistry" Content="Allow unsafe registry fixes (recommends backup first)" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. Diagnostic Storage & License Card -->
                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <TextBlock Text="DIAGNOSTIC STORAGE &amp; LICENSE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <TextBlock Text="LogicFlow System Optimizer v1.0.0 — by DelgadoLogic.Tech" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="HwidLabel" Text="HWID: Loading..." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" FontFamily="Consolas"/>
                                <TextBlock Text="DATA STORAGE PATH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DataPathLabel" Text="..." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" Margin="0,0,0,16"/>
                                
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="📋 Copy HWID" Style="{StaticResource OutlineButton}" Margin="0,0,12,8" Click="OnCopyHwidClick" Padding="16,8"/>
                                    <Button Content="📂 Open Data Folder" Style="{StaticResource OutlineButton}" Margin="0,0,12,8" Click="OnOpenDataFolderClick" Padding="16,8"/>
                                    <Button Content="🧹 Clean debug logs" Style="{StaticResource OutlineButton}" Margin="0,0,12,8" Click="OnCleanLogsClick" Padding="16,8"/>
                                    <Button Content="⚠ Reset settings to default" Style="{StaticResource ActionButton}" Margin="0,0,12,8" Click="OnResetSettingsClick" Background="#FFD32F2F" Padding="16,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ Global Loading Overlay ═══ -->
                <Border x:Name="LoadingOverlay" Background="#CC0A0E1A" Visibility="Collapsed">
                    <Border Background="#E0111827" CornerRadius="20" Padding="40,32" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="#2A3040" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Spinning arc indicator -->
                            <Border x:Name="SpinnerRing" Width="48" Height="48" CornerRadius="24"
                                    BorderThickness="3" BorderBrush="#2A3040"
                                    RenderTransformOrigin="0.5,0.5" Margin="0,0,0,20">
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
                                </Border.RenderTransform>
                                <!-- Inner arc (cyan accent) -->
                                <Border Width="42" Height="42" CornerRadius="21"
                                        BorderThickness="3,0,0,3" 
                                        BorderBrush="{StaticResource BrandCyanBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="LoadingText" Text="Scanning..." FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LoadingSubText" Text="" FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" Width="220" Height="4" Margin="0,16,0,0"
                                         Foreground="{StaticResource BrandCyanBrush}" Background="#1A1F2E"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</Window>
