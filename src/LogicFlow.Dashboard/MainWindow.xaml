<Window x:Class="LogicFlow.Dashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LogicFlow — AI-Powered Windows Optimization" 
    Height="800" Width="1280" MinWidth="1024" MinHeight="700"
    WindowStartupLocation="CenterScreen" WindowStyle="None"
    Icon="pack://application:,,,/Assets/AppIcon.jpg"
    Background="{StaticResource BrandDarkBrush}" AllowsTransparency="False"
    FontFamily="{StaticResource AppFont}">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource BrandDarkBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Sidebar Navigation ═══ -->
        <Border Grid.Column="0" Background="#0D1117" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,32">
                    <TextBlock Text="⚡ LOGICFLOW" FontSize="22" FontWeight="ExtraBold"
                               Foreground="{StaticResource BrandCyanBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="DelgadoLogic.Tech" FontSize="11" 
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Border Height="2" Margin="0,16,0,0" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00E5FF" Offset="0"/>
                                <GradientStop Color="#7C4DFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="16,0,16,16" Padding="12" CornerRadius="10" Background="#111827">
                    <StackPanel>
                        <TextBlock x:Name="LicenseLabel" Text="🆓 FREE TIER" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource WarningAmberBrush}"/>
                        <TextBlock x:Name="TrialLabel" Text="14-day Pro trial available" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8"/>
                        <Button Content="🚀 UPGRADE TO PRO — $9.99/mo" Style="{StaticResource ActionButton}" 
                                FontSize="11" Click="OnUpgradeClick"/>
                        <TextBlock Text="v1.0.0 (Build 9832) • System: Online" FontSize="9" 
                                   Foreground="#4B5563" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="12,0">
                    <TextBlock Text="MODULES" FontSize="10" FontWeight="Bold" Margin="8,0,0,8"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button x:Name="NavDashboard" Content="🏠  Dashboard" Style="{StaticResource NavButtonActive}" Click="OnNavDashboard" ToolTip="System overview &amp; quick actions"/>
                    <Button x:Name="NavSentinel" Content="🛡  Sentinel — Security" Style="{StaticResource NavButton}" Click="OnNavSentinel" ToolTip="Vulnerability scanning, network security, privacy"/>
                    <Button x:Name="NavGuardian" Content="⚡  Guardian — Performance" Style="{StaticResource NavButton}" Click="OnNavGuardian" ToolTip="Drivers, bloatware, startup, disk health, tweaks"/>
                    <Button x:Name="NavMonitor" Content="📈  Resource Monitor" Style="{StaticResource NavButton}" Click="OnNavMonitor" ToolTip="Live CPU, RAM, disk &amp; network metrics"/>
                    <Button x:Name="NavToolbox" Content="🧰  Toolbox — Utilities" Style="{StaticResource NavButton}" Click="OnNavToolbox" ToolTip="Junk cleaner, memory optimizer, turbo mode"/>
                    <Button x:Name="NavLazarus" Content="🔄  Lazarus — Recovery" Style="{StaticResource NavButton}" Click="OnNavLazarus" ToolTip="Deep-sector data recovery &amp; MTP scanning"/>
                    <Button x:Name="NavRegistry" Content="🔧  Registry Surgeon" Style="{StaticResource NavButton}" Click="OnNavRegistry" ToolTip="Registry integrity analysis &amp; repair"/>
                    
                    <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Margin="8,24,0,8"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button x:Name="NavSettings" Content="⚙  Settings" Style="{StaticResource NavButton}" Click="OnNavSettings" ToolTip="App settings, HWID, data paths"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Main Content Area ═══ -->
        <Grid Grid.Column="1" Background="{StaticResource BrandDarkBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#0D1117" Padding="20,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="System Dashboard" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border x:Name="PageBadge" Background="#1E293B" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="PageBadgeText" Text="" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrandCyanBrush}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="━" Style="{StaticResource ChromeButton}" Click="OnMinimize" ToolTip="Minimize"/>
                        <Button Content="☐" Style="{StaticResource ChromeButton}" Click="OnMaximize" ToolTip="Maximize"/>
                        <Button Content="✕" Style="{StaticResource ChromeCloseButton}" Click="OnClose" ToolTip="Close" Foreground="#6B7280"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ Page Panels (swap visibility) ═══ -->
            <Grid Grid.Row="1">

                <!-- ──── Dashboard Page ──── -->
                <!-- ──── Dashboard Page ──── -->
                <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel Opacity="1">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="DashboardTranslate" X="0" Y="0"/>
                        </StackPanel.RenderTransform>

                        <!-- Top Mini Stats Row -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- CPU Usage Mini -->
                            <Border Style="{StaticResource GlassPanel}" Padding="16,10" Margin="0,0,8,0" Grid.Column="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU ACTIVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="MiniCpuText" Grid.Row="0" Grid.Column="1" Text="—" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandCyanBrush}"/>
                                    <ProgressBar x:Name="MiniCpuBar" Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,6,0,0" Foreground="{StaticResource BrandCyanBrush}" Background="#15FFFFFF"/>
                                </Grid>
                            </Border>

                            <!-- RAM Active Mini -->
                            <Border Style="{StaticResource GlassPanel}" Padding="16,10" Margin="8,0" Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="RAM ACTIVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="MiniRamText" Grid.Row="0" Grid.Column="1" Text="—" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandPurpleBrush}"/>
                                    <ProgressBar x:Name="MiniRamBar" Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,6,0,0" Foreground="{StaticResource BrandPurpleBrush}" Background="#15FFFFFF"/>
                                </Grid>
                            </Border>

                            <!-- Disk Active Mini -->
                            <Border Style="{StaticResource GlassPanel}" Padding="16,10" Margin="8,0,0,0" Grid.Column="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DISK USAGE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="MiniDiskText" Grid.Row="0" Grid.Column="1" Text="—" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"/>
                                    <ProgressBar x:Name="MiniDiskBar" Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,6,0,0" Foreground="{StaticResource SuccessGreenBrush}" Background="#15FFFFFF"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 2-Column Overview Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Health Summary + Pulse AI Agent -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                
                                <!-- System Health Summary Card -->
                                <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Circular Dial -->
                                        <Grid Grid.Column="0" Width="140" Height="140" Margin="0,0,20,0">
                                            <ui:ProgressRing x:Name="HealthProgressRing" Progress="85" BorderThickness="8" Foreground="{StaticResource BrandCyanBrush}" Width="130" Height="130"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="HealthScoreLabel" Text="85%" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Health Score" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Hardware Specs & Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="SYSTEM HEALTH SUMMARY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hardware:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,4"/>
                                                <TextBlock x:Name="HealthHardwareLabel" Grid.Row="0" Grid.Column="1" Text="AMD Ryzen / Loading RAM..." Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Operating System:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,4"/>
                                                <TextBlock x:Name="HealthOsLabel" Grid.Row="1" Grid.Column="1" Text="Windows 11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Active Monitor:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,4"/>
                                                <TextBlock x:Name="HealthMonitorLabel" Grid.Row="2" Grid.Column="1" Text="Guardian active, monitoring drivers" Foreground="{StaticResource SuccessGreenBrush}" Margin="0,0,0,4"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Status Detail:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="HealthScoreSub" Grid.Row="3" Grid.Column="1" Text="Grade: Excellent" Foreground="{StaticResource BrandCyanBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Pulse AI Agent Diagnostic Card -->
                                <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="✨" FontSize="18" Foreground="{StaticResource BrandCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="PULSE ON-DEVICE AI DIAGNOSTICIAN" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border DockPanel.Dock="Right" Background="#1500E5FF" BorderThickness="1" BorderBrush="{StaticResource BrandCyanBrush}" CornerRadius="10" Padding="8,3">
                                                <TextBlock Text="Zero Cloud Sync · 100% Local" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrandCyanBrush}"/>
                                            </Border>
                                        </DockPanel>

                                        <!-- Terminal Output -->
                                        <Border Style="{StaticResource TerminalBoxStyle}" Height="200" Margin="0,0,0,12">
                                            <ListView x:Name="AiTerminalList" Background="Transparent" BorderThickness="0" 
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="0,2"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                            </ListView>
                                        </Border>

                                        <!-- Input Row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PulseInput" Style="{StaticResource TerminalInputStyle}" 
                                                     KeyDown="OnPulseInputKeyDown" Grid.Column="0" Margin="0,0,8,0"
                                                     VerticalContentAlignment="Center" Padding="12,8"/>
                                            <Button x:Name="BtnPulseAsk" Content="Ask Agent" Style="{StaticResource ActionButton}" Click="OnPulseAskClick" Grid.Column="1" Padding="20,10"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Column 2: Quick Actions + High-Impact Processes -->
                            <StackPanel Grid.Column="1">
                                
                                <!-- Quick Actions Card -->
                                <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="QUICK ACTIONS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="🎯 1-Click Optimize" Style="{StaticResource ActionButton}" Margin="0,0,6,8" Click="OnOneClickOptimize" Background="#00C853" FontWeight="Bold"/>
                                            <Button Content="🛡 Security Scan" Style="{StaticResource ActionButton}" Margin="6,0,0,8" Click="OnQuickSecurityScan"/>
                                            <Button Content="⚡ Performance Scan" Style="{StaticResource ActionButton}" Margin="0,0,6,8" Click="OnQuickPerfScan"/>
                                            <Button Content="🧹 Clean Junk Files" Style="{StaticResource ActionButton}" Margin="6,0,0,8" Click="OnQuickJunkClean"/>
                                            <Button Content="🧠 Optimize RAM" Style="{StaticResource ActionButton}" Margin="0,0,6,8" Click="OnQuickMemoryOptimize"/>
                                            <Button Content="🔧 Fix Registry" Style="{StaticResource ActionButton}" Margin="6,0,0,8" Click="OnQuickRegistryScan"/>
                                            <Button Content="🚀 Turbo Mode" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Click="OnToggleTurbo" Background="#FF6F00"/>
                                            <Button Content="📊 Run All Scans" Style="{StaticResource ActionButton}" Margin="6,0,0,0" Click="OnRunAllScans"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- High-Impact Running Processes Card -->
                                <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock Text="HIGH-IMPACT RUNNING PROCESSES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Button Content="🔄 Refresh" Style="{StaticResource OutlineButton}" Padding="10,5" FontSize="11" Click="OnRefreshProcessesClick" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- Processes Table (ListView with GridView) -->
                                        <ListView x:Name="ProcessesListView" Background="Transparent" BorderThickness="0" MaxHeight="250"
                                                  ItemContainerStyle="{StaticResource DashboardTableRowStyle}">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Process Name" Width="170">
                                                        <GridViewColumn.HeaderContainerStyle>
                                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}"/>
                                                        </GridViewColumn.HeaderContainerStyle>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="CPU %" Width="80">
                                                        <GridViewColumn.HeaderContainerStyle>
                                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}"/>
                                                        </GridViewColumn.HeaderContainerStyle>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding CpuFormatted}" Foreground="{StaticResource BrandCyanBrush}" HorizontalAlignment="Right"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="RAM" Width="105">
                                                        <GridViewColumn.HeaderContainerStyle>
                                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}"/>
                                                        </GridViewColumn.HeaderContainerStyle>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding MemoryFormatted}" Foreground="{StaticResource BrandPurpleBrush}" HorizontalAlignment="Right"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Action" Width="85">
                                                        <GridViewColumn.HeaderContainerStyle>
                                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}"/>
                                                        </GridViewColumn.HeaderContainerStyle>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="Kill" Click="OnTerminateProcess" 
                                                                        Background="#33EF4444" Foreground="{StaticResource DangerRedBrush}" BorderBrush="{StaticResource DangerRedBrush}" BorderThickness="1"
                                                                        FontSize="10" Padding="6,2" Cursor="Hand"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ──── Sentinel Page ──── -->
                <ScrollViewer x:Name="PageSentinel" VerticalScrollBarVisibility="Auto" Padding="24" Visibility="Collapsed">
                    <StackPanel x:Name="SentinelContent" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="0" Y="0"/>
                        </StackPanel.RenderTransform>
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="VULNERABILITY SCANNER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🛡 Run Scan" Style="{StaticResource ActionButton}" Click="OnSentinelScan" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnFixVulns" Content="🔧 Fix All" Style="{StaticResource ActionButton}" Click="OnFixVulnerabilities" 
                                                Visibility="Collapsed" Background="#E53935" Margin="0,0,8,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="SentinelStatus" Text="Click 'Run Scan' to check for vulnerabilities..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <!-- Summary bar -->
                                <Border x:Name="VulnSummaryBar" Background="#1A1F2E" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock x:Name="VulnSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnToggleVulnDetails" DockPanel.Dock="Right" Content="▼ Show Details" Click="OnToggleVulnDetails"
                                                Background="Transparent" Foreground="{StaticResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                    </DockPanel>
                                </Border>
                                <ItemsControl x:Name="VulnList" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="EXPOSED SERVICES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnDisableServices" Grid.Column="1" Content="🔒 Disable Risky" Style="{StaticResource ActionButton}" 
                                            Click="OnDisableExposedServices" Visibility="Collapsed" Background="#FF6F00" VerticalAlignment="Center"/>
                                </Grid>
                                <Border x:Name="ServiceSummaryBar" Background="#1A1F2E" CornerRadius="8" Padding="12,8" Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock x:Name="ServiceSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnToggleServiceDetails" DockPanel.Dock="Right" Content="▼ Show Details" Click="OnToggleServiceDetails"
                                                Background="Transparent" Foreground="{StaticResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                    </DockPanel>
                                </Border>
                                <ItemsControl x:Name="ServiceList" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PRIVACY SCRUBBER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🧹 Quick Scrub" Style="{StaticResource ActionButton}" Click="OnPrivacyScrub" Margin="0,0,8,0"/>
                                        <Button Content="🧹 Deep Scrub" Style="{StaticResource ActionButton}" Click="OnDeepPrivacyScrub" Background="#7C4DFF"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ScrubStatus" Text="Remove caches, temp files, and telemetry artifacts" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border x:Name="ScrubSummaryBar" Background="#1A1F2E" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="ScrubSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}"/>
                                </Border>
                                <ItemsControl x:Name="ScrubList" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Network Security Scanner (10-Vector) -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,20,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NETWORK SECURITY SCANNER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🌐 Full Network Scan" Style="{StaticResource ActionButton}" Click="OnNetworkScan" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnRemediateNetwork" Content="🔧 Fix All" Style="{StaticResource ActionButton}" Click="OnRemediateAll"
                                                Visibility="Collapsed" Background="#E53935"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="NetworkScanStatus" Text="10-vector scan: ports, ARP, DNS, firewall, WiFi, RDP, UPnP, SMBv1, WinRM, shares" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border x:Name="NetworkSummaryBar" Background="#1A1F2E" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
