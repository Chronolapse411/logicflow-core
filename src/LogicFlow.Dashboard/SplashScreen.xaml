<Window x:Class="LogicFlow.Dashboard.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LogicFlow" Width="500" Height="320"
    WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
    AllowsTransparency="True" Background="Transparent" Topmost="True">
    
    <Border CornerRadius="16" Padding="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0E1A" Offset="0"/>
                <GradientStop Color="#12182B" Offset="0.5"/>
                <GradientStop Color="#0D1117" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#00E5FF" Opacity="0.3"/>
        </Border.Effect>
        
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <!-- Brand Logo Area -->
                <TextBlock Text="⚡" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00E5FF" Offset="0"/>
                            <GradientStop Color="#7C4DFF" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                
                <!-- App Name -->
                <TextBlock Text="LOGICFLOW" FontSize="32" FontWeight="ExtraBold" 
                           HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00E5FF" Offset="0"/>
                            <GradientStop Color="#7C4DFF" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                
                <TextBlock Text="AI-Powered Windows Optimization" FontSize="11" 
                           Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,24"/>
                
                <!-- Loading Status -->
                <TextBlock x:Name="StatusLabel" Text="Initializing kernel modules..." FontSize="11"
                           Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                
                <!-- Progress Bar -->
                <Grid Width="300" Height="3" Margin="0,0,0,8">
                    <Border Background="#1A1F2E" CornerRadius="2"/>
                    <Border x:Name="ProgressFill" CornerRadius="2" 
                            HorizontalAlignment="Left" Width="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00E5FF" Offset="0"/>
                                <GradientStop Color="#7C4DFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
                
                <!-- Version -->
                <TextBlock Text="v1.0.0" FontSize="9" Foreground="#374151" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
            
            <!-- Company -->
            <TextBlock Text="DelgadoLogic.Tech" FontSize="9" Foreground="#374151" 
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
        </Grid>
    </Border>
</Window>
