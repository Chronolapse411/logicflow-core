<Application x:Class="LogicFlow.Dashboard.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="SplashScreen.xaml">
    <Application.Resources>
        <!-- LogicFlow Glassmorphism Design System -->
        
        <!-- Brand Colors -->
        <Color x:Key="BrandCyan">#00E5FF</Color>
        <Color x:Key="BrandPurple">#7C4DFF</Color>
        <Color x:Key="BrandDark">#0A0E1A</Color>
        <Color x:Key="BrandDarkPanel">#111827</Color>
        <Color x:Key="BrandGlass">#1A1F2E</Color>
        <Color x:Key="TextPrimary">#F0F4F8</Color>
        <Color x:Key="TextSecondary">#94A3B8</Color>
        <Color x:Key="SuccessGreen">#22C55E</Color>
        <Color x:Key="WarningAmber">#F59E0B</Color>
        <Color x:Key="DangerRed">#EF4444</Color>

        <SolidColorBrush x:Key="BrandCyanBrush" Color="{StaticResource BrandCyan}" />
        <SolidColorBrush x:Key="BrandPurpleBrush" Color="{StaticResource BrandPurple}" />
        <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDark}" />
        <SolidColorBrush x:Key="BrandDarkPanelBrush" Color="{StaticResource BrandDarkPanel}" />
        <SolidColorBrush x:Key="BrandGlassBrush" Color="{StaticResource BrandGlass}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />
        <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmber}" />
        <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}" />

        <LinearGradientBrush x:Key="GradientAccent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource BrandCyan}" Offset="0"/>
            <GradientStop Color="{StaticResource BrandPurple}" Offset="1"/>
        </LinearGradientBrush>

        <!-- Glass Panel Style -->
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="#1A1F2E"/>
            <Setter Property="BorderBrush" Value="#2A3040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Button Style -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" 
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{StaticResource GradientAccent}" 
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
